NODE_ENV=development
PORT=5050
MONGODB_URI=mongodb://127.0.0.1:27017/learnbase

# Also the allowlist for password-reset links, not just CORS: /auth/forgot-password
# refuses any baseResetURL whose origin is not one of these. Required at boot when
# NODE_ENV=production. Must match the deployed VITE_CLIENT_URL of each app exactly.
CLIENT_ADMIN_URL=http://localhost:5173
CLIENT_LEARNER_URL=http://localhost:5174

JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Must match the host's proxy depth: 0 when the API is reached directly,
# 1 when it sits behind exactly one reverse proxy (e.g. Vercel/Render/
# Railway/Fly). Never set to a value that trusts an untrusted network path
# -- that lets clients spoof X-Forwarded-For and bypass rate limiting.
TRUST_PROXY=0

SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-brevo-login
SMTP_PASSWORD=your-brevo-smtp-key
MAIL_FROM="LearnBase <no-reply@yourdomain.com>"

CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Test-only escape hatch, set by apps/api/src/shared/rateLimit.test.ts so the
# limiters can be exercised under NODE_ENV=test. Leave empty in a real .env.
RATE_LIMIT_IN_TESTS=

# Not read by any code yet. Reserved for later phases: refresh tokens are not
# part of the current auth contract, and Paystack arrives with Phase 4.
JWT_REFRESH_SECRET=placeholder
PAYSTACK_SECRET_KEY=placeholder

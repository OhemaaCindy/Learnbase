# Copy to .env and adjust for your environment.
#
# Everything prefixed VITE_ is compiled into the client bundle and is visible
# to anyone who loads the site. Never put a secret here -- the API holds those.

# The origin this app is served from. /auth/forgot-password sends it to the API
# as baseResetURL, and the API refuses any origin not listed in its
# CLIENT_ADMIN_URL / CLIENT_LEARNER_URL. If this does not match exactly,
# password reset fails with 400.
VITE_CLIENT_URL=http://localhost:5173

# Base URL of the LearnBase API, including the /api suffix.
# Local:      http://localhost:5050/api
# Deployed:   https://<your-api-host>/api
VITE_SERVER_URL=http://localhost:5050/api
